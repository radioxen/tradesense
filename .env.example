# TradeSense - AI Trading System Configuration
# Copy this to .env and fill in your values

# ============================================
# REQUIRED: AI API Keys
# ============================================

# OpenAI - Required for LLM agents
OPENAI_API_KEY=your_openai_api_key_here

# Perplexity - Required for market scanning and catalyst detection
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ============================================
# REQUIRED: Alpaca Paper Trading
# ============================================
# Get keys from: https://alpaca.markets

ALPACA_API_KEY=
ALPACA_API_SECRET=

# ============================================
# OPTIONAL: System Configuration
# ============================================

# Enable background scheduler for hourly analysis
ENABLE_SCHEDULER=true

# Tracing (optional)
# CREWAI_TRACING_ENABLED=true
# MLFLOW_TRACKING_URI=http://localhost:5000
